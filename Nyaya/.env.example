# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nyaya_ai
DB_USER=nyaya_user
DB_PASSWORD=nyaya_pass
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=nyaya_legal_chunks
QDRANT_VECTOR_SIZE=1024
QDRANT_ON_DISK_VECTORS=false    # set true when corpus > 10M chunks

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── LLM (Groq — free tier, fast) ─────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
LLM_GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cpu            # set cuda if GPU available locally
EMBEDDING_BATCH_SIZE=32
EMBEDDING_INGEST_BATCH_SIZE=512
EMBEDDING_CACHE_DIR=./data/embeddings/models

# ── Reranker ──────────────────────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
RERANKER_TOP_K=10

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_BM25_TOP_K=50
RETRIEVAL_VECTOR_TOP_K=30
RETRIEVAL_HYBRID_TOP_K=60
RETRIEVAL_FINAL_CONTEXT_K=6
RETRIEVAL_BM25_WEIGHT=0.55
RETRIEVAL_VECTOR_WEIGHT=0.45
RETRIEVAL_VECTOR_MIN_QUERY_WORDS=6

# ── Elasticsearch (optional — for TB-scale BM25) ─────────────────────────────
ES_ENABLED=false
ES_HOSTS=http://localhost:9200

# ── Ingestion pipeline ────────────────────────────────────────────────────────
INGEST_CELERY_BROKER=redis://localhost:6379/1
INGEST_CELERY_BACKEND=redis://localhost:6379/2
INGEST_FLUSH_BATCH_SIZE=10000
INGEST_FLUSH_INTERVAL_S=60
INGEST_CHUNK_SIZE_MB=10
INGEST_MAX_FILE_SIZE_GB=2.0
INGEST_SUMMARY_WINDOW_CHARS=12000
INGEST_SUMMARY_OVERLAP_CHARS=500

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_256_BIT_KEY_IN_PRODUCTION
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_MAX_UPLOAD_SIZE_MB=50
APP_UPLOAD_DIR=./data/raw/uploads
APP_ALLOWED_ORIGINS=["http://localhost:3000"]
