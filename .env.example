# ── NyayaAI Environment Configuration ─────────────────────────────────────────
# Copy to .env and fill in real values.
# Hardware target: 4× RTX 6000 Ada (48GB each), 512GB RAM, 27.1TB NVMe

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nyaya_ai
DB_USER=nyaya_user
DB_PASSWORD=nyaya_pass
DB_POOL_SIZE=64
DB_MAX_OVERFLOW=128
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=nyaya_legal_chunks
QDRANT_VECTOR_SIZE=1024
QDRANT_HNSW_M=32
QDRANT_HNSW_EF_CONSTRUCT=400
QDRANT_HNSW_EF=256
QDRANT_ON_DISK_PAYLOAD=false
QDRANT_ON_DISK_VECTORS=false
QDRANT_SCALAR_QUANTIZATION=true

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT=5
# Cache TTLs (seconds)
REDIS_TTL_SEARCH=3600
REDIS_TTL_EMBEDDING=86400
REDIS_TTL_SESSION=604800

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
LLM_GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cuda          # each worker sees its GPU as cuda:0 via CUDA_VISIBLE_DEVICES
EMBEDDING_BATCH_SIZE=512       # 48GB VRAM — fully saturates bge-large-en-v1.5
EMBEDDING_MAX_LENGTH=512
EMBEDDING_NORMALIZE=true
EMBEDDING_CACHE_DIR=./data/embeddings/models
EMBEDDING_GPU_COUNT=4
EMBEDDING_FP16=true            # 2x throughput, half VRAM on Ada

# ── Reranker ──────────────────────────────────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2   # L12 vs L6: better accuracy, same VRAM
RERANKER_DEVICE=cuda
RERANKER_TOP_K=20
RERANKER_BATCH_SIZE=128
RERANKER_CACHE_DIR=./data/embeddings/models
RERANKER_FP16=true

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_BM25_TOP_K=50
RETRIEVAL_VECTOR_TOP_K=30
RETRIEVAL_HYBRID_TOP_K=60
RETRIEVAL_FINAL_CONTEXT_K=6
RETRIEVAL_BM25_WEIGHT=0.55
RETRIEVAL_VECTOR_WEIGHT=0.45
RETRIEVAL_VECTOR_MIN_QUERY_WORDS=6
RETRIEVAL_RERANKER_TOP_K=20

# ── Ingestion pipeline ────────────────────────────────────────────────────────
INGEST_CELERY_BROKER=redis://localhost:6379/1
INGEST_CELERY_BACKEND=redis://localhost:6379/2
INGEST_PARSER_CONCURRENCY=32
INGEST_EMBEDDER_CONCURRENCY=4
INGEST_FLUSH_BATCH_SIZE=50000
INGEST_FLUSH_INTERVAL_S=30
INGEST_EMBED_SUBTASK_SIZE=512
INGEST_CHUNK_SIZE_MB=50
INGEST_MAX_FILE_SIZE_GB=50.0
INGEST_OCR_DPI=300
INGEST_OCR_THRESHOLD=0.6

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
APP_LOG_LEVEL=INFO
APP_UPLOAD_DIR=./data/uploads
APP_WORKERS=4
APP_MAX_UPLOAD_SIZE_MB=51200   # 50GB

# ── Auth ──────────────────────────────────────────────────────────────────────
AUTH_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Elasticsearch (optional — leave disabled unless ES cluster is running) ────
ES_ENABLED=false
ES_HOSTS=http://localhost:9200
