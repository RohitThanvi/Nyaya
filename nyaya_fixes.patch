-# ── BNS / BNSS / IPC equivalence map for normalised matching ─────────────────
-_LAW_ALIASES: Dict[str, List[str]] = {
-    "BNS":  ["BNS", "IPC"],
-    "BNSS": ["BNSS", "CrPC", "CRPC"],
-    "BSA":  ["BSA", "Evidence Act"],
-    "IPC":  ["IPC", "BNS"],
-}
